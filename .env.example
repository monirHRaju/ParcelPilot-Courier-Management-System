# Database & Redis (Docker Compose defaults)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/courier_dev?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# API & Server Configuration
PORT=4008
NODE_ENV=production

# JWT Authentication (Generate secure strings: `openssl rand -hex 32`)
JWT_ACCESS_SECRET="your_very_long_random_jwt_access_secret_key_32_chars_min"
JWT_REFRESH_SECRET="your_very_long_random_jwt_refresh_secret_key_32_chars_min"

# SMS Gateway (options: 'console' or 'bulksmsbd')
SMS_PROVIDER=console
SMS_TOKEN=

# Email SMTP (optional, leave blank for local Ethereal mailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ParcelPilot <no-reply@amaarapp.com>"

# Web Frontend Public Configuration (must be present BEFORE running `npm run build`)
NEXT_PUBLIC_API_URL="https://courier.amaarapp.com/api"
NEXT_PUBLIC_WS_URL="https://courier.amaarapp.com"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Internal API URL for Next.js Server Components on VPS
INTERNAL_API_URL="http://127.0.0.1:4008"
