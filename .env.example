DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/courier_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# API & Server Config
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMS Provider Credentials (e.g. Twilio / Termii / Vonage)
SMS_PROVIDER_API_KEY=your_sms_api_key_here
SMS_PROVIDER_SENDER_ID=your_sms_sender_id_here

# Maps & Geocoding API Keys (e.g. Google Maps / Mapbox)
MAPS_API_KEY=your_maps_api_key_here
