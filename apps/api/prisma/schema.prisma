datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  HUB_MANAGER
  RIDER
  MERCHANT
}

model User {
  id              String                @id @default(uuid())
  phone           String                @unique
  passwordHash    String
  role            Role
  isPhoneVerified Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  merchant        Merchant?
  rider           Rider?
  hubId           String?
  hub             Hub?                  @relation(fields: [hubId], references: [id])
  statusHistory   ParcelStatusHistory[]
  notifications   Notification[]        @relation("UserNotifications")
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  VAN
}

model Rider {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  vehicleType  VehicleType
  nidNumber    String
  coverageZone String
  isApproved   Boolean     @default(false)
  hubId        String?
  hub          Hub?        @relation("RiderHub", fields: [hubId], references: [id])
  createdAt    DateTime    @default(now())
  parcels      Parcel[]
}

model Merchant {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id])
  businessName      String
  businessAddress   String
  contactPersonName String
  payoutMethod      String?
  createdAt         DateTime        @default(now())
  parcels           Parcel[]
  wallet            MerchantWallet?
}

enum SizeTier {
  SMALL
  MEDIUM
  LARGE
}

enum ServiceType {
  STANDARD
  EXPRESS
}

enum PaymentType {
  COD
  PREPAID
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
}

model Address {
  id              String   @id @default(uuid())
  division        String
  district        String
  upazilaOrThana  String
  area            String
  addressLine     String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  pickupParcels   Parcel[] @relation("PickupAddress")
  deliveryParcels Parcel[] @relation("DeliveryAddress")
}

model Parcel {
  id                String                @id @default(uuid())
  merchantId        String
  merchant          Merchant              @relation(fields: [merchantId], references: [id])
  riderId           String?
  rider             Rider?                @relation(fields: [riderId], references: [id])
  recipientName     String
  recipientPhone    String
  pickupAddressId   String
  pickupAddress     Address               @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddressId String
  deliveryAddress   Address               @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  weightGrams       Int
  sizeTier          SizeTier
  codAmount         Int
  serviceType       ServiceType
  paymentType       PaymentType           @default(COD)
  baseFee           Int                   @default(0)
  codHandlingFee    Int                   @default(0)
  totalFee          Int                   @default(0)
  status            ParcelStatus          @default(PENDING)
  destinationHubId  String?
  destinationHub    Hub?                  @relation("DestinationHub", fields: [destinationHubId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  statusHistory     ParcelStatusHistory[]
  hubTransfers      HubTransfer[]
  notifications     Notification[]
  walletTransactions WalletTransaction[]
}

model ParcelStatusHistory {
  id              String       @id @default(uuid())
  parcelId        String
  parcel          Parcel       @relation(fields: [parcelId], references: [id])
  status          ParcelStatus
  changedByUserId String?
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id])
  note            String?
  createdAt       DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  type      String
  message   String
  parcelId  String?
  parcel    Parcel?  @relation(fields: [parcelId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MerchantWallet {
  id           String              @id @default(uuid())
  merchantId   String              @unique
  merchant     Merchant            @relation(fields: [merchantId], references: [id])
  balancePaisa Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

enum TxType {
  CREDIT_DELIVERY_FEE
  CREDIT_COD_COLLECTED
  DEBIT_COD_HANDLING
  DEBIT_PAYOUT
  DEBIT_RETURN_FEE
  DEBIT_ADJUSTMENT
  CREDIT_ADJUSTMENT
}

model WalletTransaction {
  id             String         @id @default(uuid())
  walletId       String
  wallet         MerchantWallet @relation(fields: [walletId], references: [id])
  type           TxType
  amountPaisa    Int
  runningBalance Int
  note           String?
  parcelId       String?
  parcel         Parcel?        @relation(fields: [parcelId], references: [id])
  createdAt      DateTime       @default(now())
  // NO updatedAt — ledger entries are immutable
}

model Hub {
  id                 String        @id @default(uuid())
  name               String
  division           String
  district           String
  upazilaOrThana     String
  addressLine        String
  latitude           Float?
  longitude          Float?
  createdAt          DateTime      @default(now())
  users              User[]
  riders             Rider[]       @relation("RiderHub")
  transfersFrom      HubTransfer[] @relation("FromHub")
  transfersTo        HubTransfer[] @relation("ToHub")
  destinationParcels Parcel[]      @relation("DestinationHub")
  zones              Zone[]
}

model Zone {
  id             String   @id @default(uuid())
  division       String
  district       String
  upazilaOrThana String   @unique
  hubId          String
  hub            Hub      @relation(fields: [hubId], references: [id])
  createdAt      DateTime @default(now())
}

enum HubTransferStatus {
  DISPATCHED
  ARRIVED
}

model HubTransfer {
  id           String            @id @default(uuid())
  parcelId     String
  parcel       Parcel            @relation(fields: [parcelId], references: [id])
  fromHubId    String?
  fromHub      Hub?              @relation("FromHub", fields: [fromHubId], references: [id])
  toHubId      String
  toHub        Hub               @relation("ToHub", fields: [toHubId], references: [id])
  status       HubTransferStatus
  dispatchedAt DateTime?
  arrivedAt    DateTime?
  createdAt    DateTime          @default(now())
}
