datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  HUB_MANAGER
  RIDER
  MERCHANT
}

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  passwordHash    String
  role            Role
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  merchant        Merchant?
  rider           Rider?
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  VAN
}

model Rider {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  vehicleType  VehicleType
  nidNumber    String
  coverageZone String
  isApproved   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  parcels      Parcel[]
}

model Merchant {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  businessName      String
  businessAddress   String
  contactPersonName String
  createdAt         DateTime @default(now())
  parcels           Parcel[]
}

enum SizeTier {
  SMALL
  MEDIUM
  LARGE
}

enum ServiceType {
  STANDARD
  EXPRESS
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
}

model Address {
  id              String   @id @default(uuid())
  division        String
  district        String
  upazilaOrThana  String
  area            String
  addressLine     String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  pickupParcels   Parcel[] @relation("PickupAddress")
  deliveryParcels Parcel[] @relation("DeliveryAddress")
}

model Parcel {
  id                String       @id @default(uuid())
  merchantId        String
  merchant          Merchant     @relation(fields: [merchantId], references: [id])
  riderId           String?
  rider             Rider?       @relation(fields: [riderId], references: [id])
  recipientName     String
  recipientPhone    String
  pickupAddressId   String
  pickupAddress     Address      @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddressId String
  deliveryAddress   Address      @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  weightGrams       Int
  sizeTier          SizeTier
  codAmount         Int
  serviceType       ServiceType
  status            ParcelStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}
