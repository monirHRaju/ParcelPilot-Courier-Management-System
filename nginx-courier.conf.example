# Nginx configuration for courier.amaarapp.com
# Place in: /etc/nginx/sites-available/courier.amaarapp.com
# Enable with: sudo ln -s /etc/nginx/sites-available/courier.amaarapp.com /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name courier.amaarapp.com;

    # Maximum upload size for parcel CSV bulk imports and rider photo uploads
    client_max_body_size 20M;

    # 1. API Backend (Express + BullMQ on port 4008)
    # The trailing slash on proxy_pass strips the '/api/' prefix before sending to Express
    location /api/ {
        proxy_pass http://127.0.0.1:4008/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. WebSockets & Socket.IO (Port 4008)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4008;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 3. Swagger API Documentation (Port 4008)
    location /api-docs {
        proxy_pass http://127.0.0.1:4008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Bull Board Queue Monitoring (Port 4008)
    location /admin/queues {
        proxy_pass http://127.0.0.1:4008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. Next.js Web Frontend (Port 3008)
    location / {
        proxy_pass http://127.0.0.1:3008;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
